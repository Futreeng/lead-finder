{
  "name": "lead-finder",
  "version": "0.1.0",
  "private": true,
  "description": "Finds small estate planning law firms from a seed list and OpenStreetMap, checks their public websites politely, and writes a prospect list for human review. Research only: it never contacts anyone.",
  "type": "module",
  "bin": {
    "lead-finder": "dist/src/cli.js"
  },
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build": "node scripts/clean.mjs && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node scripts/run-tests.mjs",
    "start": "node dist/src/cli.js"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "UNLICENSED",
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "5.9.3"
  }
}
